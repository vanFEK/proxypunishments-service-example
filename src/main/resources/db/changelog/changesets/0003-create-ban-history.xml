<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="0003-create-ban-history" author="vanfek">
        <createTable tableName="ban_history" schemaName="proxybans">
            <column name="id" type="bigserial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="player_uuid" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="issued_by_uuid" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="issued_by_name" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="varchar(255)"/>
            <column name="happened_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamptz"/>
        </createTable>

        <createIndex tableName="ban_history" indexName="idx_ban_history_player" schemaName="proxybans">
            <column name="player_uuid"/>
            <column name="happened_at" descending="true"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
