<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="0006-ip-bans" author="vanfek">
        <addColumn tableName="punishments" schemaName="proxypunishments">
            <column name="ip_address" type="inet"/>
        </addColumn>

        <!-- One active IP ban per address, regardless of which player's connection triggered it. -->
        <sql>CREATE UNIQUE INDEX idx_punishments_active_ip ON proxypunishments.punishments(ip_address) WHERE active = true AND kind = 'IP_BAN'</sql>

        <addColumn tableName="known_players" schemaName="proxypunishments">
            <column name="last_ip" type="inet"/>
            <column name="first_seen_at" type="timestamptz"/>
        </addColumn>

        <createIndex tableName="known_players" indexName="idx_known_players_last_ip"
                     schemaName="proxypunishments">
            <column name="last_ip"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
