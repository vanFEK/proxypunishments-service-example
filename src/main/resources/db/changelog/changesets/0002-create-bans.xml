<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="0002-create-bans" author="vanfek">
        <createTable tableName="bans" schemaName="proxypunishments">
            <column name="id" type="bigserial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="player_uuid" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="issued_by_uuid" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="issued_by_name" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="issued_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamptz"/>
            <column name="permanent" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- At most one active ban per player, enforced by the database rather than by application
             logic that two concurrent requests could both pass. -->
        <sql>CREATE UNIQUE INDEX idx_bans_active_player ON proxypunishments.bans(player_uuid) WHERE active = true</sql>

        <!-- Supports the expiry sweeper, which only ever scans active, non-permanent rows. -->
        <sql>CREATE INDEX idx_bans_expiry ON proxypunishments.bans(expires_at) WHERE active = true AND permanent = false</sql>
    </changeSet>
</databaseChangeLog>
